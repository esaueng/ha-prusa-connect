import { parsePrinterFileRef } from '@prusa/connect-ui/slots';

import { heldHost } from './host';

// The host calls this with the file's reference, `<device id>:<path>`, when a
// person picks the menu item on a file on a printer's Files tab. Throw or
// reject to show the person why it did not run; the host shows nothing on
// success, so report the result yourself.
// eslint-disable-next-line @typescript-eslint/require-await
export default async (printerFileRef: string): Promise<void> => {
  const host = heldHost();
  const file = parsePrinterFileRef(printerFileRef);
  if (file === undefined || host.fleet.device(file.deviceId) === undefined) {
    throw new Error(host.t('{{$.Name}}.deviceFileAction.absent'));
  }
};
